# Teacher Model Configuration
# Copy this file to teacher.env and fill in your credentials

# API Configuration
TEACHER_API_URL="https://openrouter.ai/api/v1/chat/completions"
TEACHER_API_KEY="your-api-key-here"

# Model Configuration
TEACHER_MODEL="nvidia/nemotron-3-nano-30b-a3b:free"

# Inference Settings
MAX_TOKENS=4096
TEMPERATURE=0.7
TOP_P=0.95

# Cache Settings
CACHE_ENABLED=true
CACHE_DIR="data/cache"