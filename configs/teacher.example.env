# Teacher Model Configuration
# Copy this file to teacher.env and fill in your credentials

# API Configuration
TEACHER_API_URL="https://api.your-provider.com/v1/chat/completions"
TEACHER_API_KEY="your-api-key-here"

# Model Configuration
TEACHER_MODEL="gpt-4"

# Inference Settings
MAX_TOKENS=1024
TEMPERATURE=0.7
TOP_P=0.9

# Cache Settings
CACHE_ENABLED=true
CACHE_DIR="data/cache"